---
import Layout from "../layouts/BlogPost.astro";
import config from "@shConfig";
---

<Layout
  title={config.pages.other.about.title}
  description={config.pages.other.about.subTitle}
  pubDate={new Date("August 08 2021")}
  heroImage={config.pages.other.about.heroImage}
  headings={[]}
>
  <div class="mb-16">
    <h2 class="mb-4 text-2xl font-bold">About Me</h2>
    <p class="content-text">
      Hi! I'm Yanfu Lin, passionate about sharing knowledge and personal growth.
    </p>
    <p class="content-text">
      吃飯吃七分飽，做事用八分力就好！人生是修行！每個人有每個人的路要走！忘懷得失，玩物喪志！
    </p>
  </div>
  <div class="mb-16">
    <h2 class="mb-4 text-2xl font-bold">About This Blog</h2>
    <p class="content-text">
      This blog is built with Astro, a modern framework for building fast, content-driven websites.
      It provides a clean and minimalist design to focus on the content itself.
    </p>
    <p class="content-text">
      This is a space where I share my thoughts, experiences, and knowledge on various topics.
      Whether it's technical insights or life reflections, everything stems from genuine passion and continuous learning.
    </p>
  </div>
</Layout>
